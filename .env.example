# پورتی که سرور روی آن بالا می‌آید (کلاینت روی 5000 تنطیم شده)
PORT=5000

# آدرس کلاینت برای CORS (برای چند آدرس با کاما جدا کنید)
CLIENT_ORIGIN=http://localhost:5173

# تنطیمات MySQL — مقادیر پیش‌فرض XAMPP
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=repair_management

# کلید امضای JWT — حتماً عوض کنید
JWT_SECRET=please-change-this-secret
JWT_EXPIRES_IN=8h
